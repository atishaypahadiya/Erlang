{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atishaypahadiya/erlang/schema/finding-erlang.schema.json",
  "title": "finding/1, ERLANG's extension",
  "description": "The erlang object of a finding/1 written by ERLANG. Fields are added as checks need them; see research/finding1-requirements.md. Every static finding carries a fix; a trace finding carries one when its statement or route is found in the source, and its counts in trace either way.",
  "type": "object",
  "required": [
    "strength"
  ],
  "additionalProperties": false,
  "properties": {
    "strength": {
      "enum": [
        "MUST",
        "SHOULD",
        "MAY"
      ],
      "description": "From the rule, as written in reference/."
    },
    "client": {
      "enum": [
        "fetch",
        "axios",
        "got",
        "node:http",
        "node:https",
        "pg",
        "prisma"
      ],
      "description": "The client making the call, found by where it is imported from: for no-timeout the outbound client, for n-plus-one and per-row-writes the database client."
    },
    "unresolved": {
      "const": true,
      "description": "The check could not read what decides the finding (options spread from a package, a value computed at run time), so the finding is info, not a defect."
    },
    "calls": {
      "type": "integer",
      "minimum": 1,
      "description": "no-timeout on an instance: how many calls on it set no timeout; each is listed in where.locations after the instance."
    },
    "over": {
      "enum": [
        "query result",
        "request input",
        "fixed count",
        "unknown"
      ],
      "description": "n-plus-one and per-row-writes: what the list the statement runs once per item of comes from: a query, request input, or a count written in the code above ten (a loop to 1,000). unknown goes with unresolved."
    },
    "sequential": {
      "type": "boolean",
      "description": "n-plus-one and per-row-writes: whether each item's statement waits for the one before (an await in the loop), rather than all starting together."
    },
    "rows": {
      "enum": [
        "sent",
        "loaded",
        "client page size"
      ],
      "description": "unbounded-query: sent when the rows go into a response, loaded when every row is read to compute something, client page size when the client chooses how many rows with no cap."
    },
    "connections": {
      "type": "integer",
      "minimum": 0,
      "description": "pool-sizing: the connections every deployed process can open at once (a floor when a count is unknown)."
    },
    "limit": {
      "type": "integer",
      "description": "pool-sizing: the connections the database accepts, max_connections less the reserved."
    },
    "fix": {
      "description": "The suggested fix (lib/fix.js). auto: edits a program can apply, re-checked by scripts/fix-test.js. guided: every place a person must change, and a note.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "edits"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "auto"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "file",
                      "line",
                      "column",
                      "length",
                      "replace"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "length": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "replace": {
                        "type": "string"
                      }
                    },
                    "description": "Replace length UTF-16 code units at a 1-based line and column (columns in UTF-16 code units) of file, relative to the project root."
                  },
                  {
                    "type": "object",
                    "description": "Make a file, which must not exist, relative to the project root.",
                    "required": [
                      "create",
                      "content"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "create": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "description": "Delete a file, which must exist, relative to the project root.",
                    "required": [
                      "remove"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "remove": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "locations",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "guided"
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "line"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "retrier": {
      "enum": [
        "axios-retry",
        "p-retry",
        "got",
        "loop"
      ],
      "description": "retry-policy: what retries, a library or a hand-written loop."
    },
    "attempts": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "unbounded"
        }
      ],
      "description": "retry-policy: attempts per request, the first try included."
    },
    "backoff": {
      "enum": [
        "none",
        "fixed",
        "linear",
        "exponential"
      ],
      "description": "retry-policy: how the wait between attempts grows."
    },
    "jitter": {
      "type": "boolean",
      "description": "retry-policy: whether the wait is randomised."
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "description": "missing-index: the table (or Prisma model) that needs the index."
    },
    "index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "missing-index: the columns (Prisma: fields) of the suggested index, in order."
    },
    "trace": {
      "type": "object",
      "description": "Trace evidence (research/trace-harness.md): counts recorded on seeded data, one request at a time. Counts are exact, so no count varies between runs. Timings (judge timing) carry the timing lock's verdict (lib/timing.js).",
      "required": [
        "judge",
        "scales"
      ],
      "additionalProperties": false,
      "properties": {
        "judge": {
          "enum": [
            "statements",
            "rows",
            "calls",
            "bytes",
            "fields",
            "pool",
            "attempts",
            "hang",
            "repeat",
            "memory",
            "connections",
            "plans",
            "timing"
          ],
          "description": "statements: per request, from pg_stat_statements. rows: rows the statements returned. calls: HTTP calls per page view. bytes: a response's bytes as sent. fields: the share of a response's JSON its page never reads. pool: connections checked out of the twin's pool, during an outbound call or after the response. attempts: outbound calls the stub received for one request. hang: whether the response came while the stub never answered. repeat: statements over the same request sent several times in a row. memory: the twin's heap after a full collection, per request served. connections: connections open at the database. plans: the plan PostgreSQL chose (auto_explain). timing: milliseconds, under the timing lock."
        },
        "scales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scale"
            ],
            "additionalProperties": false,
            "properties": {
              "scale": {
                "type": "integer",
                "minimum": 1
              },
              "items": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "statements": {
                "type": "integer",
                "minimum": 0
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "jsonBytes": {
                "type": "integer",
                "minimum": 0
              },
              "unreadBytes": {
                "type": "integer",
                "minimum": 0
              },
              "checkedOutDuringCall": {
                "type": "integer",
                "minimum": 0
              },
              "keptAfterResponse": {
                "type": "integer"
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              },
              "timedOut": {
                "type": "boolean"
              },
              "times": {
                "type": "integer",
                "minimum": 1
              },
              "requests": {
                "type": "integer",
                "minimum": 0
              },
              "heapBytesPerRequest": {
                "type": "number"
              },
              "connections": {
                "type": "integer",
                "minimum": 0
              },
              "tableRows": {
                "type": "integer",
                "minimum": 0
              },
              "removedRows": {
                "type": "integer",
                "minimum": 0
              },
              "ms": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "slope": {
          "type": [
            "number",
            "null"
          ],
          "description": "Extra statements or calls per extra item between the two scales."
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "The count at 10x over the count at 1x; null when it is infinite."
        },
        "statement": {
          "type": "string",
          "description": "The statement that grows, as pg_stat_statements records it."
        },
        "page": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "The request path sent at 10x."
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        },
        "unreadFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "streamed": {
          "type": "boolean",
          "description": "The response had no Content-Length: it was streamed."
        },
        "unstable": {
          "type": "boolean",
          "description": "The two measured runs differed, so nothing is judged."
        },
        "plan": {
          "type": "string",
          "description": "plans: the plan node that reads the table, as auto_explain records it (Seq Scan, Index Scan, ...)."
        },
        "table": {
          "type": "string"
        },
        "timing": {
          "type": "object",
          "description": "The timing lock's verdict (lib/timing.js): reliable only with three or more samples, relative spread of 10% or less, and the one-minute load average below half the CPU count before and after.",
          "required": [
            "reliable",
            "samples"
          ],
          "additionalProperties": false,
          "properties": {
            "reliable": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "why": {
              "type": [
                "string",
                "null"
              ]
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "median": {
              "type": [
                "number",
                "null"
              ]
            },
            "spread": {
              "type": [
                "number",
                "null"
              ]
            },
            "before": {
              "type": "object",
              "properties": {
                "load1": {
                  "type": "number"
                },
                "cpus": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "after": {
              "type": "object",
              "properties": {
                "load1": {
                  "type": "number"
                },
                "cpus": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "host": {
          "type": "string",
          "description": "attempts, hang: the upstream host the stub failed, as the twin addressed it."
        },
        "symbol": {
          "type": "string",
          "description": "hang: the function or client the request drove, when no endpoint reaches it."
        }
      }
    },
    "across": {
      "enum": [
        "fetch",
        "axios",
        "got",
        "node:http"
      ],
      "description": "pool-exhaustion: the client of the other service a connection is held across."
    },
    "blocking": {
      "enum": [
        "crypto",
        "zlib",
        "fs",
        "child_process",
        "bcrypt"
      ],
      "description": "blocking-work: what the synchronous call blocks on."
    },
    "payload": {
      "enum": [
        "select-star",
        "uncompressed",
        "chatty"
      ],
      "description": "oversized-payload: what makes the response or the page view too big: every column selected, no compression, or one call per item."
    }
  },
  "anyOf": [
    {
      "title": "fix",
      "required": [
        "fix"
      ]
    },
    {
      "title": "trace",
      "required": [
        "trace"
      ]
    }
  ]
}
